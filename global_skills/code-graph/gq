#!/usr/bin/env bash
# gq: Graphify code-graph questions for agents. Runs from the repo root (git top level), builds the graph the
# first time, rebuilds it (code only, offline, incremental) when source files changed, then passes the command
# to graphify. Each question is logged to ~/.local-model/usage.log, so /lm-savings shows what it saved.
#   gq query "<question>"   the part of the graph about a question (callers, callees, files, lines)
#   gq explain "<name>"     one symbol and its neighbours        gq path "<A>" "<B>"  how A reaches B
#   gq affected "<name>"    what uses <name> (before a change)    gq god-nodes         the most connected parts
#   gq build                rebuild now
# Saved estimate: the bytes of the source files the answer points at (up to GQ_FILES, default 5: the files an
# agent would otherwise search and open), minus the answer's own bytes; /lm-savings counts 4 bytes a token.
set -u
command -v graphify >/dev/null 2>&1 || { echo "gq: graphify is not installed (uv tool install graphifyy)" >&2; exit 2; }
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$root" || exit 2
graph=graphify-out/graph.json

# Keep the graph out of git without changing the repo's .gitignore.
exclude="$(git rev-parse --git-common-dir 2>/dev/null)/info/exclude"
if [ -f "$exclude" ] || [ -d "$(dirname "$exclude")" ]; then
  grep -qx 'graphify-out/' "$exclude" 2>/dev/null || echo 'graphify-out/' >>"$exclude"
fi

build() { graphify update . --no-cluster 2>&1 | grep -E "Rebuilt|error" >&2; }
stale() {
  [ -f "$graph" ] || return 0
  [ -n "$(find . \( -name .git -o -name graphify-out -o -name build -o -name node_modules -o -name .gradle \
    -o -name .venv \) -prune -o -type f -newer "$graph" \( -name '*.kt' -o -name '*.kts' -o -name '*.java' \
    -o -name '*.py' -o -name '*.ts' -o -name '*.tsx' -o -name '*.js' -o -name '*.mjs' -o -name '*.go' -o -name '*.rs' \
    -o -name '*.swift' -o -name '*.c' -o -name '*.cpp' -o -name '*.h' -o -name '*.cs' -o -name '*.rb' -o -name '*.php' \
    -o -name '*.dart' -o -name '*.sh' \) -print -quit)" ]
}

[ "${1:-}" = build ] && { build; exit 0; }
[ $# -gt 0 ] || { sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }
stale && build

out=$(mktemp); trap 'rm -f "$out"' EXIT
t0=$(date +%s%3N)
graphify "$@" | tee "$out"
rc=${PIPESTATUS[0]}
ms=$(( $(date +%s%3N) - t0 ))

# Bytes of the distinct files the answer names (src=path or path:L12), first GQ_FILES of them.
refs=$(node -e '
const fs = require("fs"), text = fs.readFileSync(process.argv[1], "utf8"), max = Number(process.argv[2]) || 5;
const seen = new Set(); let bytes = 0;
for (const m of text.matchAll(/(?:src=)?([\w.\/\\-]+\.[A-Za-z0-9]+)(?::L\d+|\s+loc=L\d+|\])/g)) {
  const p = m[1];
  if (seen.has(p) || seen.size >= max) continue;
  try { const s = fs.statSync(p); if (s.isFile()) { seen.add(p); bytes += s.size; } } catch {}
}
console.log(bytes);' "$out" "${GQ_FILES:-5}" 2>/dev/null || echo 0)
f="${LOCAL_MODEL_USAGE_LOG_FILE:-$HOME/.local-model/usage.log}"
mkdir -p "$(dirname "$f")"
printf '%s\tgraphify\t%s\t%s\t%s %s\t%s\t%s\n' "$(date -Iseconds)" "$ms" "${refs:-0}" "${1:-}" \
  "$(wc -c <"$out" | tr -d ' ')" "$root" "$(printf '%s ' "$@" | tr '\t\r\n' '   ')" >>"$f" 2>/dev/null
exit "$rc"
