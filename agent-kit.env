# Single config file for the Android Agent Kit scripts. Fill the blanks.
# Gradle root, relative to the repo root (the Android app is not at the top level here).
GRADLE_DIR=tvfreedom-android
APP_MODULE=:androidCMP
# Build variant for compile/assemble/test tasks, e.g. DevDebug when the app has flavors.
APP_VARIANT=Debug
APPLICATION_ID=io.github.raghavsatyadev.tvfreedom
BASE_BRANCH=main
# 1 = ktfmt Google style is enforced (ci-local job 1, pre-commit). 0 = off: this code base keeps
# its own 4-space, long-line style, and a reformat would push files past 500 lines.
FORMAT_CHECK=0
# Pin a ktfmt version (blank = latest release from Maven Central).
KTFMT_VERSION=
# Android NDK version that setup-env checks (blank = skip the check).
NDK_VERSION=
